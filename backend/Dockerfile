# 1. Используем стабильный и легковесный LTS образ Node.js на базе Alpine Linux
FROM node:20-alpine

# 2. Указываем рабочую директорию внутри контейнера
WORKDIR /usr/src/app

# 3. Копируем файлы конфигурации зависимостей
COPY package*.json ./

# 4. Устанавливаем только production-зависимости для уменьшения размера образа
RUN npm ci --only=production

# 5. Копируем оставшийся исходный код бэкенда
COPY . .

# 6. Открываем порт (Render автоматически прокинет сюда трафик через переменную PORT)
EXPOSE 10000

# 7. Запускаем сервер
CMD [ "npm", "start" ]
